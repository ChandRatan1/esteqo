# Copy to .env and fill in your values. Never commit the real .env.

NODE_ENV=development
PORT=4143

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=gNxt@123456789
DB_NAME=esteqo

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:4142,http://localhost:4144

# Requests per window per IP for the public write endpoints (appointments/contact).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=30

# Shared secret for the blog authoring endpoints (/api/admin/blog/*).
# Send it as the `x-admin-key` header. Blank = those routes are disabled.
ADMIN_API_KEY=esteqo-admin-api-key
