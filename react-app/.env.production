# Production build overrides — loaded by `npm run build`, taking precedence
# over .env (which is a LOCAL DEV file and points at http://localhost:4143).
#
# These MUST stay blank. Vite bakes env values into the bundle at build time,
# so a non-blank value here ships to every visitor. With them blank, the app
# falls back to window.location.origin at runtime (see src/api/apiOrigin.js),
# which resolves to https://esteqo.com in production and adapts automatically
# if the site ever moves domain.
#
# Leaving .env's localhost values in place would point every API call at the
# VISITOR'S own machine, silently breaking the blog, services, contact forms,
# quiz, gift cards and admin on the live site.
VITE_BLOG_API=
VITE_SERVICES_API=
VITE_CONTACT_API=

VITE_SITE_URL=https://esteqo.com
