# Copy to .env. All values are optional — the site runs with none of them set.

# ---------------------------------------------------------------------------
# Enquiry delivery
# ---------------------------------------------------------------------------
# Enquiries are posted straight from the browser to a hosted form service and
# emailed to ratanchandbind4056@gmail.com (sender) with neetukumarseo00@gmail.com
# copied. The visitor's mail app is NEVER opened.
#
# Default transport is FormSubmit — no key required. One-time step: the first
# submission sends a confirmation email to ratanchandbind4056@gmail.com; click
# the link in it once and every later enquiry arrives automatically.
#
# After activating, FormSubmit issues a random alias for the address. Paste it
# here so the inbox is not visible in the page source.
VITE_FORMSUBMIT_ID=

# Optional alternative transport. Set a free key from https://web3forms.com
# (created against ratanchandbind4056@gmail.com) to use Web3Forms instead.
VITE_WEB3FORMS_KEY=

# Optional: also save every submission to the MySQL `contacts` table.
# Set to the API origin, e.g. http://localhost:4000 in development.
# Leave blank and the site only emails — nothing else changes.
VITE_CONTACT_API=http://localhost:4143

# Blog + admin authoring API. Setting this makes /blog read posts from MySQL
# and enables the authoring screen at /admin/blog.
#
# It also makes department pages (/services/:slug) and treatment pages
# (/treatments/:slug) read from MySQL and enables /admin/services — the same
# PHP backend serves both, so one URL covers it. Set VITE_SERVICES_API instead
# only if services truly live on a different origin than the blog.
#
# The /services catalogue page (with its category rail and groups) always
# reads the bundled menu in src/data — it has curated fields the database
# schema does not carry yet.
VITE_BLOG_API=
VITE_SERVICES_API=

# ---------------------------------------------------------------------------
# Data source
# ---------------------------------------------------------------------------
# false / unset  -> the site reads the bundled menu in src/data (no backend).
# true           -> the site reads the Express + MySQL API in ../backend.
VITE_USE_API=false

# Only used when VITE_USE_API=true. Leave blank in dev; Vite proxies /api.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api requests (only relevant with VITE_USE_API).
VITE_API_PROXY=http://localhost:4143

# Canonical domain. Drives canonical tags, Open Graph URLs and the sitemap.
VITE_SITE_URL=https://esteqo.com

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Blank = no tracking.
VITE_GA_ID=
