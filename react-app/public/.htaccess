# ESTEQO — Apache config for Hostinger shared hosting.
#
# Vite copies everything in public/ into dist/, so this ships with the build.
# Upload the CONTENTS of dist/ into public_html (not the dist folder itself).

# ---------------------------------------------------------------------------
# 1. Single-page app routing  — REQUIRED
# ---------------------------------------------------------------------------
# React Router handles /services, /blog/my-post and so on in the browser. Apache
# knows nothing about them, so a direct visit or a refresh would 404. This sends
# any request that is not a real file or folder to index.html and lets React
# resolve it. Without this block every URL except "/" breaks on reload.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ---------------------------------------------------------------------
  # 0. Redirect the old WordPress site's URLs — REQUIRED before go-live
  # ---------------------------------------------------------------------
  # esteqo.com is currently live on WordPress (the "Meni" theme) with these
  # exact URLs already indexed by Google. Once this build replaces it, every
  # one of them would 404 without a redirect, throwing away that indexing —
  # a real 301 here tells Google (and anyone with an old link or bookmark)
  # where the content moved, instead of just breaking.
  #
  # Real, previously-linked pages only — the WordPress install also had ~30
  # unused theme demo pages (Typography, Portfolio, Pricing Table, Plastic
  # Surgeons, Practical Nurses, etc.) that were never part of the real site
  # and are left to 404 naturally rather than redirected.
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^faq/?$ /values [R=301,L]
  RewriteRule ^appointment-i/?$ /appointment [R=301,L]
  RewriteRule ^appointment-ii/?$ /appointment [R=301,L]
  RewriteRule ^brows/?$ /services/brows [R=301,L]
  RewriteRule ^facials-skin-treatments/?$ /services/facials [R=301,L]
  RewriteRule ^add-on-treatments/?$ /services/add-on-treatments [R=301,L]
  RewriteRule ^body-bleach-polish/?$ /services/body-bleach-detan [R=301,L]
  RewriteRule ^threading-face-waxing/?$ /services/threading [R=301,L]
  RewriteRule ^massages/?$ /services/massages [R=301,L]
  # No equivalent category exists yet for these two — send to the menu hub
  # rather than losing the visitor (and the indexed URL) to a 404.
  RewriteRule ^japanese-head-spa/?$ /services [R=301,L]
  RewriteRule ^leaser-hair-removal/?$ /services [R=301,L]
  RewriteRule ^package/?$ /services [R=301,L]
  # Old theme demo "staff" pages that were nonetheless live in the nav menu.
  RewriteRule ^(lab-testing|plastic-surgeons|practical-nurses|surgery-assistant)/?$ /about [R=301,L]
  # Old theme demo wellness services, also live in the nav menu.
  RewriteRule ^(balanced-nutrition-diet|belly-fat-reduction-exercise|free-healthy-living-diet|health-wellness-camps|meditation-energy-healing|nutrition-health-guide|premium-wellness-club|weight-loss-friendly-foods|yoga-therapy-for-your-knees)/?$ /services [R=301,L]

  # Send the real /sitemap.xml and /robots.txt URLs to the live PHP versions,
  # generated from the database on every request (backend-php/routes/sitemap.php).
  # This must come before the "serve real files as-is" rule below, since the
  # static build/ copies of these two files would otherwise win. If you ever
  # deploy the front end with no PHP backend at all, delete these two lines to
  # fall back to the static build-time files in public/.
  RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L]
  RewriteRule ^robots\.txt$ /api/robots.txt [L]

  # Leave the API and uploaded files alone if they are proxied on this domain.
  RewriteRule ^api/ - [L]
  RewriteRule ^uploads/ - [L]

  # Real files and directories are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Every SPA route — /, /services, /treatments/hydra-facial, /blog/my-post —
  # goes through PHP first, which serves the real built index.html with this
  # exact page's title/description/OG/canonical/robots tags injected into its
  # <head>, live from the database. "View Source" on any page now shows the
  # correct tags directly, with no JavaScript needed — this is what makes
  # link-preview bots (WhatsApp, Facebook, Twitter/X, LinkedIn) and search
  # crawlers see real per-page content instead of one generic default.
  #
  # The React app then boots exactly as before — nothing about how the site
  # looks or behaves changes for a real visitor, only the initial HTML is
  # richer. If this rule is ever removed, index.html is served as a plain
  # static file instead (the same behaviour the site had before this).
  RewriteRule ^(.*)$ /api/render-shell?path=$1 [L,QSA]
</IfModule>

# ---------------------------------------------------------------------------
# 2. Force HTTPS
# ---------------------------------------------------------------------------
# The admin password travels in a request header, so plain HTTP must not be an
# option. Enable the free SSL certificate in hPanel first, or this will loop.

<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# 3. Caching
# ---------------------------------------------------------------------------
# Vite fingerprints asset filenames (index-a1b2c3.js), so they can be cached
# hard. index.html must never be cached or visitors keep an old app shell after
# a deploy. robots.txt and sitemap.xml stay short-lived so SEO edits show up.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 6 months"
  ExpiresByType image/png               "access plus 6 months"
  ExpiresByType image/webp              "access plus 6 months"
  ExpiresByType image/svg+xml           "access plus 6 months"
  ExpiresByType font/woff2              "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "max-age=3600"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Basic hardening.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# 4. Compression
# ---------------------------------------------------------------------------

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 5. Keep dotfiles private
# ---------------------------------------------------------------------------

<FilesMatch "^\.">
  Require all denied
</FilesMatch>
